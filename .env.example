# ---- Discord credentials ----
# Bot token from the Discord Developer Portal (Bot -> Reset Token).
DISCORD_TOKEN=
# Application (client) ID from the Developer Portal (General Information).
CLIENT_ID=
# The single guild (server) ID this bot operates on. Slash commands are
# registered per-guild for instant availability.
GUILD_ID=

# ---- Storage ----
# Path to the SQLite database file. Parent directory is created on startup.
DATABASE_PATH=./data/analytics.sqlite

# ---- Behavior ----
# Default lookback window (in days) for reports/backfill when not specified.
DEFAULT_DAYS=7
# If true, /refresh-backfill will read the audit log (requires View Audit Log)
# to reconstruct admin removals (kicks, bans, prunes) within the window.
BACKFILL_AUDIT_LOG=true
# Hard cap on how many messages are fetched per channel during backfill.
MAX_MESSAGES_PER_CHANNEL=1000
# Raw message rows older than this many days are deleted by the cleanup job.
DELETE_RAW_MESSAGES_AFTER_DAYS=14
